/* =========================================================
   REFINAMENTO PROTOCOLO BOTC — CORES DA IMAGEM
   ========================================================= */

:root {
  --bg0: #050B1A;
  --bg1: #020617;
  --card: rgba(15, 23, 42, 0.9);
  --border: rgba(255, 255, 255, 0.12);
  --text: #EAF2FF;
  --muted: rgba(234, 242, 255, 0.75);
  
  /* AJUSTE PARA O CIANO DA IMAGEM */
  --accent: #00d4ff; 
  --accent2: #0077ff;
  --shadow: 0 18px 55px rgba(0,0,0,0.6);
}

/* CORREÇÃO DO TAMANHO DO PROTOCOLO/POSTER */
.founder-poster {
  width: 100% !important;
  max-width: 450px !important; /* Tamanho de autoridade, não 50px! */
  height: auto !important;
  display: block !important;
  margin: 25px auto !important;
  border-radius: 15px;
  box-shadow: 0 0 30px rgba(0, 212, 255, 0.3); /* Brilho ciano */
  border: 1px solid rgba(0, 212, 255, 0.2);
}

/* ESTILO DO HERO (IGUAL À IMAGEM QUE MANDASTE) */
.hero h1 {
  color: var(--accent) !important;
  font-weight: 900 !important;
  text-transform: uppercase;
  letter-spacing: -2px;
  font-size: clamp(40px, 8vw, 80px); /* BOTC Gigante */
}

.hero h3 {
  color: var(--accent);
  letter-spacing: 4px;
  font-size: 14px;
  margin-bottom: 10px;
}
